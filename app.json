{
  "expo": {
    "name": "FinTrackApp",
    "slug": "FinTrackApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoapp2.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logoapp2.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0D7377"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoapp_clean.png",
        "backgroundColor": "#0D7377"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.rafael86.FinTrackApp"
    },
    "web": {
      "favicon": "./assets/logoapp2.jpg"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "FinTrackApp necesita acceso a la cámara para tomar fotos.",
          "microphonePermission": "FinTrackApp necesita acceso al micrófono para grabar video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FinTrackApp necesita acceso a la cámara para tomar fotos.",
          "photosPermission": "FinTrackApp necesita acceso a tus fotos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2f350b97-3497-4b26-a73d-bd4ff526739d"
      }
    }
  }
}
